{
  "name": "hassad-hr",
  "version": "1.0.0",
  "private": true,
  "description": "Hassad Coffee Roasters HR app — single-file deployable HTML app",
  "scripts": {
    "build": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --minify",
    "watch": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --watch",
    "www": "node scripts/build-www.mjs",
    "ios:sync": "npm run www && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  }
}
